# Dependencies
node_modules/

# Build outputs
dist/
client/dist/
client/dist-cvm/
.space-build/
.space-build-cvm/
.bun-cache/
.harness/

# Runtime data (never commit)
app.db
app.db-wal
app.db-shm
*.db-wal
*.db-shm

# Secrets (never commit)
.env
.env.local
*.pem
*.key

# Build QA artifacts
audits/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript incremental build info (machine-specific)
*.tsbuildinfo
.tsbuildinfo.*

# Any env variant except the documented example
.env.*
!.env.example

# Local data directory (database, temporary uploads)
data/

# Cold-loop proposals can quote alert data
memory/proposals/*
!memory/proposals/README.md
# Evaluation reports can quote alert data
eval/reports/
eval/lookup-cache.json
