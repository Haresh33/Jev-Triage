# Copy to .env and fill in. Only TYPESAFE_API_KEY is required; every other source is optional.

# --- Jev (required): makes every decision ---------------------------------------------------------
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest                 # pin a version (e.g. jev-1.13.0) once you are happy with results
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- Enrichment (optional, strongly recommended) --------------------------------------------------
# Without VirusTotal, files and URLs cannot be checked, so the guardrail keeps them from closing as benign.
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=                        # free Shodan InternetDB is always used for IPs
ABUSEIPDB_API_KEY=

# --- Log search (optional, recommended): the agent searches your EDR / SIEM / XDR around each alert -------
# Fill in any of the sources below; every source with complete settings is used (or list them in LOG_SOURCES).
# Use read-only credentials. Values from alerts are checked and quoted before they go into any query.
# LOG_SOURCES=                         # e.g. defender,splunk (default: every configured source; "none" turns it off)
# LOG_SEARCH_OPENING=host_activity,process_tree   # run at once for every alert (others are offered to Jev as leads)
# LOG_SEARCH_WINDOW_MINUTES=30         # minutes either side of the alert time
# LOG_SEARCH_TIMEOUT_SECONDS=30
# LOG_SEARCH_MAX_EVENTS=200
#
# CrowdStrike Falcon (Next-Gen SIEM event search). API client scopes: NGSIEM read + write (write is needed to start a search).
# CROWDSTRIKE_CLIENT_ID=
# CROWDSTRIKE_CLIENT_SECRET=
# CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com   # US-2 api.us-2… · EU-1 api.eu-1… · GOV api.laggar.gcw…
# CROWDSTRIKE_REPOSITORY=search-all                  # or investigate_view (Falcon Insight telemetry)
# CROWDSTRIKE_MEMBER_CID=                            # Flight Control child CID, if any
#
# Splunk Enterprise / Splunk Cloud (REST search export, CIM field names). A Splunk authentication token.
# SPLUNK_URL=https://splunk.corp.example:8089         # Splunk Cloud: https://<stack>.splunkcloud.com:8089 (allow-list this server's IP)
# SPLUNK_TOKEN=
# SPLUNK_BASE_SEARCH=index=*                          # narrow it, e.g. index=edr OR index=wineventlog
#   Self-signed certificate on 8089? Point NODE_EXTRA_CA_CERTS at your CA file rather than turning checks off.
#
# Google SecOps (Chronicle API UDM search). Service account with chronicle.events.udmSearch.
# SECOPS_CREDENTIALS_FILE=/run/secrets/secops.json    # or SECOPS_CREDENTIALS_JSON='{…}'
# SECOPS_PROJECT=                                     # Google Cloud project bound to the SecOps instance
# SECOPS_LOCATION=us                                  # us, eu, europe-west2, …
# SECOPS_INSTANCE=                                    # the SecOps customer ID (instance GUID)
#
# Elastic (Elasticsearch / Elastic Security, ECS fields). API key with read on the indices.
# ELASTIC_URL=https://my-deployment.es.us-east-1.aws.elastic.cloud:443
# ELASTIC_API_KEY=                                    # the "encoded" value
# ELASTIC_INDEX=logs-*                                # e.g. logs-endpoint.events.*,winlogbeat-*
#
# Microsoft Defender XDR (advanced hunting via Microsoft Graph). App permission ThreatHunting.Read.All.
# DEFENDER_TENANT_ID=
# DEFENDER_CLIENT_ID=
# DEFENDER_CLIENT_SECRET=
# DEFENDER_GRAPH_URL=https://graph.microsoft.com      # GCC High: https://graph.microsoft.us
# DEFENDER_LOGIN_URL=https://login.microsoftonline.com # GCC High: https://login.microsoftonline.us
#
# Trend Vision One (search API v3.0). API key role: XDR Data Explorer, view / filter / search.
# VISIONONE_TOKEN=
# VISIONONE_BASE_URL=https://api.xdr.trendmicro.com   # EU api.eu.xdr… · SG api.sg.xdr… · JP api.xdr.trendmicro.co.jp · AU api.au.xdr… · IN api.in.xdr… · UK api.uk.xdr… · ME api.mea.xdr…

# --- Reviewer AI (optional, any model) --------------------------------------------------------------
# Jev makes every triage call. A second model adds advisory second opinions, audits risky benign closures,
# and powers `bun run review`. It never changes a verdict (unless AI_MODE=tiebreak).
# Anthropic (default):
# AI_API_KEY=sk-ant-...                 # ANTHROPIC_API_KEY also works
# AI_MODEL=claude-sonnet-5              # comma-separated; later ones are fallbacks
# Any OpenAI-compatible API (OpenAI, Azure OpenAI, Gemini, OpenRouter, Mistral, Groq, Ollama, vLLM, LM Studio):
# AI_PROVIDER=openai
# AI_API_KEY=...                        # OPENAI_API_KEY also works; not needed for a local server
# AI_MODEL=gpt-4.1-mini                 # required for this provider
# AI_BASE_URL=https://api.openai.com/v1
#   Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash
#   Azure:   AI_BASE_URL=https://<resource>.openai.azure.com/openai/v1             AI_MODEL=<deployment name>
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1                                AI_MODEL=llama3.1
# AI_MODE=second_opinion                # off | second_opinion | tiebreak (tiebreak lets the AI settle cases Jev can't)

# --- Server -----------------------------------------------------------------------------------------
# HOST=127.0.0.1                       # 127.0.0.1 = this machine only. Any other value requires a login below.
# PORT=3000
# DATA_DIR=./data                      # database and temporary uploads
# RETENTION_DAYS=0                     # delete cases older than N days (0 = keep)
# WORKER_CONCURRENCY=2                 # investigations that run at the same time

# ---- Cold loop (improves the agent between runs; see "Getting more accurate" in the README)
# MEMORY_DIR=./memory                  # reviewed organisation context and question wording, read at triage time
# EVAL_DIR=./eval                      # labelled cases, evaluation reports and recorded lookups
# `bun run review` uses the reviewer AI above; triage itself never waits for it.

# ---- Hot / warm loops
# RELATED_WINDOW_DAYS=14               # days of case history searched for related cases (0 = off)
# AI_AUDIT=on                          # the reviewer AI rechecks risky benign closures (default on when a reviewer AI is set)
# AI_AUDIT_SAMPLE_PERCENT=5            # also recheck this share of other benign closures
# AI_AUDIT_DAILY_MAX=50                # at most this many audits in any 24 hours

# ---- Alert webhook: your SIEM / XDR / EDR pushes alerts in, and triage starts the moment they arrive
# INGEST_TOKEN=                        # at least 24 characters (openssl rand -hex 24); unset = webhook off

# ALLOWED_HOSTS=                       # extra names the app is reached by, e.g. triage.corp.example
#                                      # (localhost / 127.0.0.1 always work; other names are refused
#                                      #  unless listed here or a login is set)

# --- Login (required when HOST is not 127.0.0.1) --------------------------------------------------
# AUTH_USER=analyst
# AUTH_PASSWORD=
# ALLOW_NO_AUTH=false                  # only if a reverse proxy in front already handles login
