{
  "name": "jev-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adaptive security-alert triage where Jev answers every question.",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "NODE_ENV=production bun server/src/server.ts",
    "dev": "bun --watch server/src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "eval": "bun scripts/eval.ts",
    "review": "bun scripts/review.ts",
    "memory": "bun scripts/memory.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "@zip.js/zip.js": "2.8.11",
    "bun-plugin-tailwind": "0.1.2",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.6.3"
  }
}
