# ---- Required ---------------------------------------------------------------
TYPESAFE_API_KEY=            # Jev: makes every malicious / benign call  (typesafe.ai)
TRIAGE_API_TOKEN=            # any long random string; callers send it as X-API-Key
# TRIAGE_ALLOW_UNAUTHENTICATED=1   # local dev only: serve /triage with no token (default: refuse)

# ---- Free enrichment keys (each one optional, more = better verdicts) ----------
VT_API_KEY=                  # virustotal.com -> profile -> API key (free: 4 lookups/min, 500/day)
ABUSECH_AUTH_KEY=            # auth.abuse.ch (free) -> one key covers URLhaus, MalwareBazaar, ThreatFox
ABUSEIPDB_API_KEY=           # abuseipdb.com (free: 1,000 checks/day)
# Keyless, always on: DNS-over-HTTPS (Google), RDAP domain age, Shodan InternetDB

# ---- Optional: Claude writes the analyst summary (Jev cannot write text) -------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=anthropic:claude-sonnet-5
TIEBREAKER=human             # human = escalate when Jev stays unsure;  claude = let Claude break the tie
CLAUDE_QUESTIONS=5          # extra questions Claude may write per unsure round (0 = off)

# ---- Tuning ----------------------------------------------------------------------
JEV_MODEL=jev-latest         # pin e.g. jev-1.13.0 once thresholds are tuned
MALICIOUS_AT=0.85            # Jev p(malicious) >= this  -> malicious
BENIGN_AT=0.15               # Jev p(malicious) <= this  -> benign ; in between -> gather more evidence
MAX_ROUNDS=3
MAX_IOCS=25
MAX_PIVOTS_PER_ROUND=8
VT_RPM=4                     # raise if you have a premium VirusTotal key
VT_MAX_PER_ALERT=12
ALLOWLIST_DOMAINS=           # comma-separated, e.g. yourcompany.com,yourvendor.net
